{
  "name": "worldex",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "node server/dev.mjs",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "test": "node --test",
    "build": "tsc -b && vite build && node --check server/index.mjs && node --check server/app.mjs",
    "typecheck": "tsc --noEmit",
    "test:mysql": "node --test server/repository.mysql.test.mjs",
    "verify": "bash scripts/verify-environment.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "express": "^5.3.0",
    "lucide-react": "0.468.0",
    "mysql2": "^3.24.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.2"
  }
}
